@page "{id:int}"
@model ProposalEval.Pages.Jobs.ScoresModel
@{
    ViewData["Title"] = $"Review scores {Model.Job.Vendor!.Name}";
    var vendorStatus = StatusLabels.Vendor(Model.Job.Vendor.Status);
    var scoreStatus = StatusLabels.Score(Model.Evaluation.Status);
}

<p>
    <a asp-page="/Rfqs/Results" asp-route-id="@Model.Job.RfqId">← Results</a>
    ·
    <a asp-page="/Rfqs/Details" asp-route-id="@Model.Job.RfqId">@Model.Job.Rfq.Number</a>
</p>
<h1 class="page-title">Review scores</h1>
<p class="lede">
    @Model.Job.Vendor.Name
    · project @(Model.Job.Vendor.ExternalProjectId ?? "—")
    · job #@Model.Evaluation.JobId
    <span class="badge-status @StatusLabels.Badge(vendorStatus)">@vendorStatus</span>
    <span class="badge-status @StatusLabels.Badge(scoreStatus)">@scoreStatus</span>
</p>

<div id="review-flash" class="banner-live d-none"></div>
<div id="review-error" class="alert alert-danger d-none"></div>

<div class="card-block">
    <h2 class="h5">Totals</h2>
    <p class="lede">Accept to keep this vendor in the ranking. Reject to leave them out. Other vendors are unchanged.</p>
    <p class="mb-2"><strong>TWS:</strong> @Model.Evaluation.Tws.ToString("0.00") / 70</p>
    <p class="mb-2"><strong>Technical:</strong> @(Model.Evaluation.TechnicalPass ? "Pass" : "Fail") (line 49.00)</p>
    <p class="mb-0"><strong>Mandatory:</strong> @(Model.Evaluation.MandatoryPass ? "Pass" : "Fail")</p>
</div>

<div class="card-block">
    <h2 class="h5">Recommendation</h2>
    @if (string.IsNullOrWhiteSpace(Model.Evaluation.Recommendation))
    {
        <p class="mb-0">No recommendation was saved.</p>
    }
    else
    {
        <pre class="summary-body">@Model.Evaluation.Recommendation</pre>
    }
</div>

<div class="card-block">
    <h2 class="h5">Scores</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Criterion</th>
                <th>Score</th>
                <th>Justification</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var score in Model.Evaluation.Scores.OrderBy(s => s.Criterion.SortOrder).ThenBy(s => s.Criterion.Code))
        {
            <tr>
                <td>@score.Criterion.Code</td>
                <td>@score.Criterion.Name</td>
                <td>@score.Score.ToString("0.00")</td>
                <td>@(score.Justification ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.CanReview)
{
    <div class="d-flex gap-2 mb-3">
        <button id="accept-scores" class="btn btn-navy" type="button" data-job-id="@Model.Job.Id" data-rfq-id="@Model.Job.RfqId">Accept scores</button>
        <button class="btn btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#reject-modal">Reject scores</button>
    </div>

    <div class="modal fade" id="reject-modal" tabindex="-1" aria-labelledby="reject-title" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="reject-title">Reject scores</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="reject-reason">Reason</label>
                    <textarea id="reject-reason" class="form-control" rows="4" maxlength="2000" placeholder="Why these scores should not stand."></textarea>
                    <p id="reject-field-error" class="missing mt-2 mb-0 d-none"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button id="confirm-reject" type="button" class="btn btn-outline-danger" data-job-id="@Model.Job.Id" data-rfq-id="@Model.Job.RfqId">Reject</button>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.Summary is not null)
{
    <p><a asp-page="/Jobs/Review" asp-route-id="@Model.Summary.JobId">Accepted summary</a></p>
}

@section Scripts {
    <script>
        (function () {
            const flash = document.getElementById("review-flash");
            const errorBox = document.getElementById("review-error");

            function showError(message) {
                errorBox.textContent = message;
                errorBox.classList.remove("d-none");
                flash.classList.add("d-none");
            }

            async function postJson(url, body) {
                const headers = { "Accept": "application/json" };
                const options = { method: "POST", headers };
                if (body !== undefined) {
                    headers["Content-Type"] = "application/json";
                    options.body = JSON.stringify(body);
                }
                const response = await fetch(url, options);
                const payload = await response.json();
                if (!payload || payload.code < 200 || payload.code >= 300) {
                    throw new Error((payload && payload.error) || "The request failed.");
                }
                return payload.data;
            }

            const accept = document.getElementById("accept-scores");
            if (accept) {
                accept.addEventListener("click", async function () {
                    accept.disabled = true;
                    try {
                        await postJson("/api/jobs/" + accept.dataset.jobId + "/scores/accept");
                        window.location.href = "/Rfqs/Results/" + accept.dataset.rfqId;
                    } catch (err) {
                        accept.disabled = false;
                        showError(err.message);
                    }
                });
            }

            const confirmReject = document.getElementById("confirm-reject");
            const reasonField = document.getElementById("reject-reason");
            const fieldError = document.getElementById("reject-field-error");
            if (confirmReject && reasonField) {
                confirmReject.addEventListener("click", async function () {
                    const reason = reasonField.value.trim();
                    if (!reason) {
                        fieldError.textContent = "A rejection reason is required.";
                        fieldError.classList.remove("d-none");
                        return;
                    }
                    fieldError.classList.add("d-none");
                    confirmReject.disabled = true;
                    try {
                        await postJson("/api/jobs/" + confirmReject.dataset.jobId + "/scores/reject", { reason: reason });
                        window.location.href = "/Rfqs/Results/" + confirmReject.dataset.rfqId;
                    } catch (err) {
                        confirmReject.disabled = false;
                        showError(err.message);
                        bootstrap.Modal.getInstance(document.getElementById("reject-modal"))?.hide();
                    }
                });
            }
        })();
    </script>
}
